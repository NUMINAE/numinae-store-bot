# Telegram bot token from @BotFather (Telegram: message @BotFather -> /newbot)
BOT_TOKEN=

# Your numeric Telegram user id (message @userinfobot, or see README for how to find it)
OWNER_ID=

# Path to the SQLite database file, relative to the project root
DB_PATH=data/shop.db

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Payment mode (required). "stars" sends real Telegram Stars invoices.
# "mock" is a DEMO mode: the "Pay (demo)" button grants content without any payment,
# so it must never run with real content. Use it only for local development.
PAYMENT_MODE=mock

# Load a fictional demo catalogue into an empty database: true or false (default false).
# Demo content only: leave this false once you add your own catalogue.
SEED_DEMO=true
